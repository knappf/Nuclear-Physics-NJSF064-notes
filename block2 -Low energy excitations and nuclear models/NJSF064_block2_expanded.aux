\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Radial wave functions $R_{n\ell }(r)$ with $n=1,2,3$ and $\ell =0,1,2$ for the infinite square well of radius $R$ (top, in units of $R^{-3/2}$), for the Woods--Saxon potential with $A=208$, $V_0=50$~MeV, $a=0.67$~fm (middle, in fm$^{-3/2}$; the dashed line marks $R_{\rm  WS}=7.5$~fm) and for the harmonic oscillator (bottom, in units of $\nu ^{3/2}$, $\nu =\sqrt  {m\omega /\hbar }$).}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:radial}{{4}{13}{Radial wave functions $R_{n\ell }(r)$ with $n=1,2,3$ and $\ell =0,1,2$ for the infinite square well of radius $R$ (top, in units of $R^{-3/2}$), for the Woods--Saxon potential with $A=208$, $V_0=50$~MeV, $a=0.67$~fm (middle, in fm$^{-3/2}$; the dashed line marks $R_{\rm WS}=7.5$~fm) and for the harmonic oscillator (bottom, in units of $\nu ^{3/2}$, $\nu =\sqrt {m\omega /\hbar }$)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Proton densities $\rho _p(r)$, normalized to $Z$, for $Z=8$, $20$, $28$, $50$, $82$, $126$ protons, corresponding to $^{16}$O, $^{40}$Ca, $^{58}$Ni, $^{116}$Sn, $^{208}$Pb and the hypothetical $^{310}126$ ($N=184$). Model densities: harmonic oscillator (blue), Woods--Saxon potential (green; $V_0=50$~MeV, $R_{\rm  WS}=1.27\,A^{1/3}$~fm, $a=0.67$~fm) and infinite square well (red). For the HO and the square well, $\hbar \omega $ and $R_{\rm  sw}$ are fixed by $\mathinner {\langle {r^2}\rangle }=\frac  35R^2$, $R=1.2\,A^{1/3}$~fm. Orbits are filled in the spin-orbit order ($1s_{1/2}$, $1p_{3/2}$, $1p_{1/2}$, $1d_{5/2}$, \dots  ). The dashed line is the equivalent sharp radius $R_{\rm  eq}=\sqrt  {5\mathinner {\langle {r^2}\rangle }_{\rm  HO}/3}$. Open circles: measured charge densities from elastic electron scattering (Fourier--Bessel fits, sum of Gaussians for $^{116}$Sn; de Vries et al.\ 1987); no data exist for $Z=126$.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:density}{{5}{14}{Proton densities $\rho _p(r)$, normalized to $Z$, for $Z=8$, $20$, $28$, $50$, $82$, $126$ protons, corresponding to $^{16}$O, $^{40}$Ca, $^{58}$Ni, $^{116}$Sn, $^{208}$Pb and the hypothetical $^{310}126$ ($N=184$). Model densities: harmonic oscillator (blue), Woods--Saxon potential (green; $V_0=50$~MeV, $R_{\rm WS}=1.27\,A^{1/3}$~fm, $a=0.67$~fm) and infinite square well (red). For the HO and the square well, $\hbar \omega $ and $R_{\rm sw}$ are fixed by $\braket {r^2}=\frac 35R^2$, $R=1.2\,A^{1/3}$~fm. Orbits are filled in the spin-orbit order ($1s_{1/2}$, $1p_{3/2}$, $1p_{1/2}$, $1d_{5/2}$, \dots ). The dashed line is the equivalent sharp radius $R_{\rm eq}=\sqrt {5\braket {r^2}_{\rm HO}/3}$. Open circles: measured charge densities from elastic electron scattering (Fourier--Bessel fits, sum of Gaussians for $^{116}$Sn; de Vries et al.\ 1987); no data exist for $Z=126$}{figure.5}{}}
