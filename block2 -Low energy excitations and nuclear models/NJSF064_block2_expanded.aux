\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Simplect shell model: nucleons in a mean-field potential}{4}{subsection.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Single-particle spectra: harmonic oscillator (left), Woods--Saxon potential with $V_0=50$~MeV, $R=7.52$~fm, $a=0.67$~fm (middle), and infinite square well (right). Each spectrum is shifted so that $E_{1s}=0$ and scaled to the HO shell energies (units of $\hbar \omega $). Numbers in brackets are the degeneracies $2(2\ell +1)$ (HO: of the whole shell); boxed numbers give the total number of particles below gaps larger than $0.38\,\hbar \omega $. Dashed lines connect the same $n\ell $ states.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:spspectra}{{3}{9}{Single-particle spectra: harmonic oscillator (left), Woods--Saxon potential with $V_0=50$~MeV, $R=7.52$~fm, $a=0.67$~fm (middle), and infinite square well (right). Each spectrum is shifted so that $E_{1s}=0$ and scaled to the HO shell energies (units of $\hbar \omega $). Numbers in brackets are the degeneracies $2(2\ell +1)$ (HO: of the whole shell); boxed numbers give the total number of particles below gaps larger than $0.38\,\hbar \omega $. Dashed lines connect the same $n\ell $ states}{figure.3}{}}
