\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Schmidt lines $\mu (j)=j\big  [g_\ell \pm (g_s-g_\ell )/(2\ell +1)\big  ]$ for $j=\ell +\frac  12$ (blue) and $j=\ell -\frac  12$ (red), for odd-proton (left) and odd-neutron (right) nuclei. The dashed lines use a quenched spin $g$-factor $g_s^{\rm  eff}=0.7\,g_s$. Symbols: measured ground-state magnetic moments of doubly magic $\pm 1$ nucleon nuclei; full symbols = particle (magic $+1$), open symbols = hole (magic $-1$), the colour indicating $j=\ell \pm \frac  12$ of the occupied orbit. Data: N.~J.~Stone, At.\ Data Nucl.\ Data Tables \textbf  {90} (2005) 75; IAEA report INDC(NDS)-0658 (2014).}}{19}{figure.7}\protected@file@percent }
\newlabel{fig:schmidt}{{7}{19}{Schmidt lines $\mu (j)=j\big [g_\ell \pm (g_s-g_\ell )/(2\ell +1)\big ]$ for $j=\ell +\frac 12$ (blue) and $j=\ell -\frac 12$ (red), for odd-proton (left) and odd-neutron (right) nuclei. The dashed lines use a quenched spin $g$-factor $g_s^{\rm eff}=0.7\,g_s$. Symbols: measured ground-state magnetic moments of doubly magic $\pm 1$ nucleon nuclei; full symbols = particle (magic $+1$), open symbols = hole (magic $-1$), the colour indicating $j=\ell \pm \frac 12$ of the occupied orbit. Data: N.~J.~Stone, At.\ Data Nucl.\ Data Tables \textbf {90} (2005) 75; IAEA report INDC(NDS)-0658 (2014)}{figure.7}{}}
