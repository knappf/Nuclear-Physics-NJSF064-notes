\newlabel{fig:radial}{{3}{8}{Radial wave functions $R_{n\ell }(r)$ with $n=1,2,3$ and $\ell =0,1,2$ for the infinite square well of radius $R$ (top, in units of $R^{-3/2}$) and for the harmonic oscillator (bottom, in units of $\nu ^{3/2}$, $\nu =\sqrt {m\omega /\hbar }$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Density profiles of $A_f$ spin-$\frac  12$ fermions in the harmonic oscillator (blue), the Woods--Saxon potential (green; $V_0=50$~MeV, $R_{\rm  WS}=1.27\,(2A_f)^{1/3}$~fm, $a=0.67$~fm) and the infinite square well (red). For the HO and the square well, $\hbar \omega $ and $R_{\rm  sw}$ are fixed by $\mathinner {\langle {r^2}\rangle }=\frac  35R^2$, $R=1.2\,(2A_f)^{1/3}$~fm. Orbits are filled in the spin-orbit order ($1s_{1/2}$, $1p_{3/2}$, $1p_{1/2}$, $1d_{5/2}$, \dots  ). The dashed line is the equivalent sharp radius $R_{\rm  eq}=\sqrt  {5\mathinner {\langle {r^2}\rangle }_{\rm  HO}/3}$.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:density}{{4}{10}{Density profiles of $A_f$ spin-$\frac 12$ fermions in the harmonic oscillator (blue), the Woods--Saxon potential (green; $V_0=50$~MeV, $R_{\rm WS}=1.27\,(2A_f)^{1/3}$~fm, $a=0.67$~fm) and the infinite square well (red). For the HO and the square well, $\hbar \omega $ and $R_{\rm sw}$ are fixed by $\braket {r^2}=\frac 35R^2$, $R=1.2\,(2A_f)^{1/3}$~fm. Orbits are filled in the spin-orbit order ($1s_{1/2}$, $1p_{3/2}$, $1p_{1/2}$, $1d_{5/2}$, \dots ). The dashed line is the equivalent sharp radius $R_{\rm eq}=\sqrt {5\braket {r^2}_{\rm HO}/3}$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Single-particle spectra without spin-orbit term: harmonic oscillator (left), Woods--Saxon potential with $V_0=50$~MeV, $R=7.52$~fm, $a=0.67$~fm (middle), and infinite square well (right). Each spectrum is shifted so that $E_{1s}=0$ and scaled to the HO shell energies (units of $\hbar \omega $). Numbers in brackets are the degeneracies $2(2\ell +1)$ (HO: of the whole shell); boxed numbers give the total number of particles below gaps larger than $0.38\,\hbar \omega $. Dashed lines connect the same $n\ell $ states.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:spspectra}{{5}{11}{Single-particle spectra without spin-orbit term: harmonic oscillator (left), Woods--Saxon potential with $V_0=50$~MeV, $R=7.52$~fm, $a=0.67$~fm (middle), and infinite square well (right). Each spectrum is shifted so that $E_{1s}=0$ and scaled to the HO shell energies (units of $\hbar \omega $). Numbers in brackets are the degeneracies $2(2\ell +1)$ (HO: of the whole shell); boxed numbers give the total number of particles below gaps larger than $0.38\,\hbar \omega $. Dashed lines connect the same $n\ell $ states}{figure.5}{}}
