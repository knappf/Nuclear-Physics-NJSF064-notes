\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Neutron (left) and proton (right) single-particle levels of the Woods--Saxon potential with spin-orbit and Coulomb terms (Seminole parameters) for nuclei on the $\beta $-stability line, as a function of $A$ (top axis: $N$ or $Z$). Colours label $\ell $; solid lines $j=\ell +\frac  12$, dashed $j=\ell -\frac  12$. Thick segments are occupied orbits, the dotted line is the last occupied level $\varepsilon _F$, and boxes mark the shell closures. }}{16}{figure.6}\protected@file@percent }
\newlabel{fig:spevolA}{{6}{16}{Neutron (left) and proton (right) single-particle levels of the Woods--Saxon potential with spin-orbit and Coulomb terms (Seminole parameters) for nuclei on the $\beta $-stability line, as a function of $A$ (top axis: $N$ or $Z$). Colours label $\ell $; solid lines $j=\ell +\frac 12$, dashed $j=\ell -\frac 12$. Thick segments are occupied orbits, the dotted line is the last occupied level $\varepsilon _F$, and boxes mark the shell closures}{figure.6}{}}
