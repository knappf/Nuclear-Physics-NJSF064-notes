\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Positive-parity spectra of ${}^{18}$O, ${}^{19}$O and ${}^{20}$O (2, 3 and 4 valence neutrons): shell-model calculation in the $sd$ shell with the same USD single-particle energies and two-body matrix elements (B.~H.~Wildenthal, Prog.\ Part.\ Nucl.\ Phys.\ \textbf  {11}, 5 (1984)), compared with experiment (ENSDF; evaluations D.~R.~Tilley \emph  {et al.}, Nucl.\ Phys.\ A \textbf  {595}, 1 (1995) for $A=18$, 19 and D.~R.~Tilley \emph  {et al.}, Nucl.\ Phys.\ A \textbf  {636}, 249 (1998) for $A=20$). Energies are given relative to ${}^{16}$O plus the valence neutrons, the experimental ground-state energies are from the AME2020 mass evaluation (M.~Wang \emph  {et al.}, Chin.\ Phys.\ C \textbf  {45}, 030003 (2021)). Experimental levels with a tentative spin are dashed; dotted lines connect the lowest state of each $J^\pi $.}}{26}{figure.9}\protected@file@percent }
\newlabel{fig:O18USD}{{9}{26}{Positive-parity spectra of ${}^{18}$O, ${}^{19}$O and ${}^{20}$O (2, 3 and 4 valence neutrons): shell-model calculation in the $sd$ shell with the same USD single-particle energies and two-body matrix elements (B.~H.~Wildenthal, Prog.\ Part.\ Nucl.\ Phys.\ \textbf {11}, 5 (1984)), compared with experiment (ENSDF; evaluations D.~R.~Tilley \emph {et al.}, Nucl.\ Phys.\ A \textbf {595}, 1 (1995) for $A=18$, 19 and D.~R.~Tilley \emph {et al.}, Nucl.\ Phys.\ A \textbf {636}, 249 (1998) for $A=20$). Energies are given relative to ${}^{16}$O plus the valence neutrons, the experimental ground-state energies are from the AME2020 mass evaluation (M.~Wang \emph {et al.}, Chin.\ Phys.\ C \textbf {45}, 030003 (2021)). Experimental levels with a tentative spin are dashed; dotted lines connect the lowest state of each $J^\pi $}{figure.9}{}}
